# SMTP (wajib untuk mengirim email)
SMTP_HOST=smtp.contoh.com
SMTP_PORT=587
SMTP_USER=user@contoh.com
SMTP_PASSWORD=rahasia-atau-app-password

# Pengirim (SMTP_FROM diutamakan jika EMAIL_FROM juga ada)
# SMTP_FROM="Nama <user@contoh.com>"
# EMAIL_FROM="Nama Anda <user@contoh.com>"

# Port 465 = TLS langsung (secure). Port 587 = STARTTLS (jangan set SMTP_SECURE=true)
# Untuk 587, kode memakai requireTLS; abaikan SMTP_SECURE.

# Opsional: paksa IPv4 jika error ECONNREFUSED ke alamat IPv6 (default tanpa env = IPv4)
# SMTP_IP_FAMILY=4
# SMTP_IP_FAMILY=6
# SMTP_IP_FAMILY=auto

# Jika error TLS "self-signed certificate in certificate chain" (proxy/antivirus SSL, SMTP internal):
# SMTP_TLS_REJECT_UNAUTHORIZED=false
